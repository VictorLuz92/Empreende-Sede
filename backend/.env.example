# Copie para .env e preencha com as credenciais do seu projeto Supabase
SPRING_PROFILES_ACTIVE=supabase
SUPABASE_DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
SUPABASE_DB_USER=postgres.seu_projeto_ref
SUPABASE_DB_PASSWORD=sua_senha_do_banco

# Administrador único
APP_ADMIN_EMAIL=seu_email_adm@exemplo.com
APP_ADMIN_PASSWORD=sua_senha_forte_adm
APP_JWT_SECRET=troque_por_uma_chave_secreta_longa_e_aleatoria

# OAuth 2.0 (Opcional: habilita "Entrar com Google" e "Entrar com Microsoft/Outlook")
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=

# Chave Pix para cobrança de R$ 50,00 / mês
APP_PIX_KEY=sua_chave_pix_aqui
APP_PIX_MERCHANT_NAME=EMPREENDE SEDE
APP_PIX_MERCHANT_CITY=SUA CIDADE
